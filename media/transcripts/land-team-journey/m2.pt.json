{"module":2,"title":"Total Responsibility","vimeoId":"1217937969","vimeoName":"3. Responsabilidade total","language":"pt","durationSec":379,"machineTranslated":false,"native":true,"source":"vimeo-api","generatedAt":1786972324152,"segments":[{"t0":0,"t1":3.5,"text":"Imagine duas pessoas que cometem o mesmo erro."},{"t0":3.5,"t1":5.5,"text":"A primeira pessoa diz,"},{"t0":5.5,"t1":7,"text":"a culpa não foi minha."},{"t0":7,"t1":9,"text":"As ferramentas não eram boas."},{"t0":9,"t1":11,"text":"Ninguém me avisou."},{"t0":11,"t1":13,"text":"As instruções não eram claras."},{"t0":13,"t1":15,"text":"A segunda pessoa diz,"},{"t0":15,"t1":17,"text":"eu podia ter feito mais perguntas."},{"t0":17,"t1":19.5,"text":"Devia ter verificado o meu trabalho."},{"t0":19.5,"t1":21,"text":"Vou corrigir."},{"t0":21,"t1":23,"text":"E fazer melhor da próxima vez."},{"t0":23,"t1":26.5,"text":"Qual dessas pessoas acha que vai crescer mais depressa?"},{"t0":26.5,"t1":28,"text":"A segunda,"},{"t0":28,"t1":29,"text":"por quê?"},{"t0":29,"t1":31.5,"text":"Porque se concentra naquilo que pode controlar."},{"t0":31.5,"t1":35.5,"text":"A isto chama-se responsabilidade total."},{"t0":35.5,"t1":39,"text":"Responsabilidade total significa assumir responsabilidade"},{"t0":39,"t1":40.5,"text":"pelas suas ações,"},{"t0":40.5,"t1":42,"text":"pela sua atitude"},{"t0":42,"t1":44,"text":"e pela forma como reage."},{"t0":44,"t1":47,"text":"Não significa que tudo seja culpa sua"},{"t0":47,"t1":49,"text":"e não significa culpar-se por coisas"},{"t0":49,"t1":51,"text":"que estão fora do seu controlo."},{"t0":51,"t1":53,"text":"Significa perguntar"},{"t0":53,"t1":56,"text":"o que posso fazer para melhorar esta situação?"},{"t0":56,"t1":58,"text":"O que posso aprender?"},{"t0":58,"t1":60,"text":"Qual é o melhor próximo passo?"},{"t0":60,"t1":62,"text":"As pessoas que crescem"},{"t0":62,"t1":64,"text":"fazem estas perguntas regularmente."},{"t0":64,"t1":65,"text":"Por vezes,"},{"t0":65,"t1":68,"text":"há situações que realmente não são culpa sua."},{"t0":68,"t1":70,"text":"Um fornecedor atrasa-se."},{"t0":70,"t1":71,"text":"O tempo muda."},{"t0":71,"t1":73,"text":"Uma máquina varia-se."},{"t0":73,"t1":76,"text":"Alguém esquece-se de transmitir uma informação importante."},{"t0":76,"t1":78,"text":"Essas coisas acontecem."},{"t0":78,"t1":81,"text":"Mas mesmo quando não pode controlar o que aconteceu,"},{"t0":81,"t1":84,"text":"pode controlar o que faz a seguir."},{"t0":84,"t1":85,"text":"Pode queixar-se."},{"t0":85,"t1":87,"text":"Pode culpar alguém."},{"t0":87,"t1":90,"text":"Pode esperar que outra pessoa resolva o problema."},{"t0":90,"t1":91,"text":"Ou pode perguntar,"},{"t0":91,"t1":93,"text":"qual é o melhor próximo passo?"},{"t0":93,"t1":97,"text":"As pessoas que assumem responsabilidade procuram soluções."},{"t0":97,"t1":100,"text":"Não desperdiçam energia à procura de alguém para culpar."},{"t0":100,"t1":103,"text":"Utilizam essa energia para comunicar,"},{"t0":103,"t1":105,"text":"para resolver e para avançar."},{"t0":105,"t1":107,"text":"Vejamos um exemplo simples."},{"t0":107,"t1":110,"text":"O seu responsável pede-lhe um relatório para sexta-feira."},{"t0":110,"t1":113,"text":"Na quarta-feira, percebe que está atrasado."},{"t0":113,"t1":115,"text":"Uma pessoa mantém-se em silêncio."},{"t0":115,"t1":117,"text":"Espera que o problema desapareça."},{"t0":117,"t1":119,"text":"A sexta-feira chega."},{"t0":119,"t1":121,"text":"E o relatório ainda não está terminado."},{"t0":121,"t1":124,"text":"Outra pessoa fala na quarta-feira e diz,"},{"t0":124,"t1":125,"text":"Estou atrasado."},{"t0":125,"t1":127,"text":"Pode ajudar-me a definir prioridades?"},{"t0":127,"t1":129,"text":"Isto é o que já conclui."},{"t0":129,"t1":132,"text":"E isto é o que ainda falta."},{"t0":132,"t1":136,"text":"Em qual das duas pessoas é mais fácil confiar?"},{"t0":136,"t1":138,"text":"Na segunda."},{"t0":138,"t1":142,"text":"Assumir responsabilidade significa comunicar cedo."},{"t0":142,"t1":145,"text":"Significa não esconder problemas."},{"t0":145,"t1":147,"text":"As mais notícias não melhoram,"},{"t0":147,"t1":149,"text":"só porque ficam em silêncio."},{"t0":149,"t1":152,"text":"Um pequeno problema comunicado cedo"},{"t0":152,"t1":155,"text":"pode muitas vezes ser resolvido."},{"t0":155,"t1":159,"text":"Um problema escondido normalmente torna-se maior."},{"t0":159,"t1":162,"text":"Imagine que está a construir uma vedação."},{"t0":162,"t1":164,"text":"Faz uma medição."},{"t0":164,"t1":166,"text":"Mas algo não parece estar certo."},{"t0":166,"t1":168,"text":"Pode ignorar."},{"t0":168,"t1":169,"text":"Pode continuar."},{"t0":169,"t1":171,"text":"E esperar que corra bem."},{"t0":171,"t1":174,"text":"Ou pode parar, fazer uma pergunta"},{"t0":174,"t1":177,"text":"e verificar novamente a medida."},{"t0":177,"t1":180,"text":"Isso é assumir responsabilidade."},{"t0":180,"t1":182,"text":"Uma pequena conversa hoje"},{"t0":182,"t1":185,"text":"pode evitar um grande erro amanhã."},{"t0":185,"t1":189,"text":"A responsabilidade revela-se muitas vezes em pequenos momentos."},{"t0":189,"t1":192,"text":"Quando pergunta, em vez de adivinhar."},{"t0":192,"t1":196,"text":"Quando verifica, em vez de esperar que esteja certo."},{"t0":196,"t1":200,"text":"Quando comunica, em vez de ficar em silêncio."},{"t0":200,"t1":203,"text":"Quando corringe, em vez de esconder."},{"t0":203,"t1":206,"text":"Na nossa empresa, não esperamos perfeição."},{"t0":206,"t1":208,"text":"Toda a gente comete erros."},{"t0":208,"t1":212,"text":"Toda a gente deixa escapar alguma coisa de vez em quando."},{"t0":212,"t1":215,"text":"O que importa é o que acontece a seguir."},{"t0":215,"t1":218,"text":"Escondo erro, arranja desculpas."},{"t0":218,"t1":220,"text":"Espera que outra pessoa o descubra."},{"t0":220,"t1":224,"text":"O admite, aprende e ajuda a corrigir."},{"t0":224,"t1":226,"text":"As pessoas respeitam a honestidade,"},{"t0":226,"t1":229,"text":"respeitam quem assume responsabilidade"},{"t0":229,"t1":232,"text":"e confiam em quem comunica a verdade cedo."},{"t0":232,"t1":234,"text":"Há outro ponto importante."},{"t0":234,"t1":237,"text":"A responsabilidade é contagiosa."},{"t0":237,"t1":240,"text":"Quando uma pessoa assume responsabilidade,"},{"t0":240,"t1":243,"text":"as outras começam muitas vezes a fazer o mesmo."},{"t0":243,"t1":244,"text":"A conversa muda."},{"t0":244,"t1":247,"text":"Em vez de perguntar, quem causou isto?"},{"t0":247,"t1":251,"text":"A equipe começa a perguntar, como resolvemos isto?"},{"t0":251,"t1":253,"text":"Em vez de se protegerem,"},{"t0":253,"t1":256,"text":"as pessoas começam a apoiar-se umas às outras."},{"t0":256,"t1":260,"text":"E quando isso acontece, toda a equipe se torna mais forte."},{"t0":260,"t1":262,"text":"Lembre-se desta frase."},{"t0":262,"t1":265,"text":"As desculpas impedem o crescimento."},{"t0":265,"t1":268,"text":"A responsabilidade cria crescimento."},{"t0":268,"t1":271,"text":"As desculpas mantêm a atenção no passado."},{"t0":271,"t1":275,"text":"A responsabilidade direciona a atenção para o futuro."},{"t0":275,"t1":278,"text":"As desculpas perguntam, de quem é a culpa?"},{"t0":278,"t1":282,"text":"A responsabilidade pergunta, o que posso fazer agora?"},{"t0":282,"t1":286,"text":"A segunda pergunta vai sempre ajudá-lo a avançar."},{"t0":286,"t1":290,"text":"Da próxima vez que algo ocorrer mal, pare por um momento."},{"t0":290,"t1":292,"text":"Repare na sua primeira reação."},{"t0":292,"t1":294,"text":"Pode sentir frustração."},{"t0":294,"t1":296,"text":"Pode querer defender-se."},{"t0":296,"t1":300,"text":"Pode querer explicar por que razão o problema não foi culpa sua."},{"t0":300,"t1":302,"text":"Essa reação é normal,"},{"t0":302,"t1":304,"text":"mas não precisa de ficar nesse lugar."},{"t0":304,"t1":307,"text":"Pode respirar fundo e perguntar,"},{"t0":307,"t1":310,"text":"que parte desta situação posso influenciar?"},{"t0":310,"t1":312,"text":"Que ação posso tomar?"},{"t0":312,"t1":314,"text":"Quem precisa de saber?"},{"t0":314,"t1":317,"text":"O que posso aprender para a próxima vez?"},{"t0":317,"t1":319,"text":"Estas perguntas criam progresso."},{"t0":319,"t1":321,"text":"E quanto mais vezes as fizer,"},{"t0":321,"t1":324,"text":"mais natural será assumir responsabilidade."},{"t0":324,"t1":326,"text":"Por isso, esta semana,"},{"t0":326,"t1":329,"text":"pratique a responsabilidade total."},{"t0":329,"t1":331,"text":"Se algo ocorrer mal,"},{"t0":331,"t1":333,"text":"não procure primeiro uma desculpa."},{"t0":333,"t1":335,"text":"Procure a sua próxima ação."},{"t0":335,"t1":337,"text":"Faça perguntas."},{"t0":337,"t1":339,"text":"Verifique o seu trabalho."},{"t0":339,"t1":341,"text":"Comunique cedo."},{"t0":341,"t1":342,"text":"Resolva problemas."},{"t0":342,"t1":344,"text":"Aprenda com os erros."},{"t0":344,"t1":346,"text":"Apoie os seus colegas."},{"t0":346,"t1":348,"text":"E continue a avançar."},{"t0":348,"t1":351,"text":"Porque as pessoas que assumem responsabilidade"},{"t0":351,"t1":354,"text":"tornam-se pessoas dignas de confiança."},{"t0":354,"t1":359,"text":"As pessoas de confiança recebem mais responsabilidade."},{"t0":359,"t1":362,"text":"E quem sabe lidar bem com a responsabilidade"},{"t0":362,"t1":364,"text":"torna-se líder."},{"t0":364,"t1":367,"text":"A responsabilidade total não começa com um cargo."},{"t0":367,"t1":369,"text":"Começa com uma escolha."},{"t0":369,"t1":371,"text":"A escolha de deixar de culpar."},{"t0":371,"t1":374,"text":"A escolha de começar a agir."},{"t0":374,"t1":376,"text":"E a escolha de perguntar"},{"t0":376,"t1":378,"text":"o que posso fazer agora."}]}